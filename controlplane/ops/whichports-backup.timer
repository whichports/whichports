# Nightly, off the hour so it does not land with everything else that runs at
# midnight. Persistent, so a box that was off overnight still takes one.
[Unit]
Description=Schedule the whichports control plane backup

[Timer]
OnCalendar=*-*-* 03:17:00
RandomizedDelaySec=5m
Persistent=true

[Install]
WantedBy=timers.target
