# Hourly, not every five minutes. A probing pass sends packets to other
# people's networks, so its pace is a courtesy question and not only a cost
# one, and docs/PRODUCT.md section 5 holds the budget it stays inside.
#
# The jitter is ten minutes rather than seconds, so a fleet that grows does not
# arrive at every customer's firewall on the hour together.
#
# Persistent, so a box that was off takes one pass on the way up rather than
# waiting for the next hour to come round.
[Unit]
Description=Schedule a whichports probing pass

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
