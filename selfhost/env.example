# Your instance's settings. Copy this file to selfhost/.env and fill it in:
#
#   cp selfhost/env.example selfhost/.env
#
# Compose reads .env for the names compose.yaml uses, and hands the whole file
# to the control plane and the worker. The repository ignores .env, so what
# you put in it stays on this machine. This example holds no secret and must
# never hold one.

# The name your dashboard answers on. Your agents report to it, the install
# command and every mail link point at it, and Caddy gets its certificate for
# it on 443. Point its A record at this machine first, and its AAAA record
# too when this machine has that IPv6 address.
WHICHPORTS_DOMAIN=whichports.example.com

# Our Caddy as the front door, with the certificate. Remove this line to put
# a reverse proxy you already run in front instead (selfhost/README.md, "Your
# own proxy").
COMPOSE_PROFILES=caddy

# Where the stack listens on this machine. Nothing listens on 80. A port that
# is taken stops the stack at start and says which.
#
# Caddy must have port 443 from the internet: it gets its certificate there,
# and the authority's check of it "is performed via TLS on port 443"
# (letsencrypt.org/docs/challenge-types, read 2026-10-20). Move it only when
# something forwards port 443 to the new one as it is, never behind a proxy
# or load balancer that ends TLS. The one-line install keeps 443.
WHICHPORTS_HTTPS_PORT=443
# The control plane's own port on 127.0.0.1. Change it only when something
# else already holds it.
WHICHPORTS_INGEST_PORT=8410

# Our probers. Your invitation is one line that starts with whpinvite1_ and
# holds our API's address and both keys. Put it here, and leave the three
# lines below empty: the stack refuses both at once.
WHICHPORTS_PROBER_INVITE=

# Or the same as three lines, the way an invitation used to come.
# Set all three or none: with only some of them a pass stops and says so.
WHICHPORTS_PROBER_API=
WHICHPORTS_PROBER_API_KEY=
WHICHPORTS_PROBER_PROOF_KEY=

# Alert mail. With no recipient nothing is sent and every alert is still
# recorded on the dashboard.
WHICHPORTS_ALERT_TO=
WHICHPORTS_ALERT_FROM=
WHICHPORTS_SMTP_HOST=
WHICHPORTS_SMTP_PORT=587
WHICHPORTS_SMTP_USER=
WHICHPORTS_SMTP_PASSWORD=

# Alerts to a chat server or a webhook receiver inside your own network. Off
# unless this line reads exactly yes. With it, an alert may go to a private
# address, and anybody who may add a channel here can make this instance send
# one to an address in your network. selfhost/README.md says which addresses.
# WHICHPORTS_ALERTS_TO_PRIVATE_ADDRESSES=yes
